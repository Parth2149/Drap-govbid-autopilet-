      "parameters": {
        "jsCode": "const items = $input.all();\nconst fullText = items[0].json.text || \"\";\n\nconst chunkSize = 1200;\nconst overlap = 200;\nconst chunks = [];\n\nlet startIndex = 0;\nlet chunkIndex = 1;\n\nwhile (startIndex < fullText.length) {\n  const endIndex = Math.min(startIndex + chunkSize, fullText.length);\n  const chunkText = fullText.substring(startIndex, endIndex).trim();\n\n  if (chunkText.length > 50) {\n    chunks.push({\n      json: {\n        chunk_number: chunkIndex,\n        requirement_text: chunkText,\n        character_count: chunkText.length\n      }\n    });\n    chunkIndex++;\n  }\n  startIndex += (chunkSize - overlap);\n}\n\nreturn chunks;"
      },
